    "preview": "vite preview",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@gltf-studio/audio-canvas": "workspace:*",
    "@gltf-studio/audio-graph": "workspace:*",
    "@gltf-studio/audio-webaudio": "workspace:*",
    "@gltf-studio/editor-core": "workspace:*",
    "@gltf-studio/engine-api": "workspace:*",
    "@gltf-studio/engine-three": "workspace:*",
    "@gltf-studio/graph-canvas": "workspace:*",
    "@gltf-studio/script-panel": "workspace:*",
    "@gltf-studio/storage": "workspace:*",
    "@gltfi/gltf": "0.0.1",
    "audio-graph-js": "0.1.0",
    "@xyflow/react": "^12.11.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.2.1"
