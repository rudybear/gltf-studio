{
  "name": "@gltf-studio/play",
  "version": "0.0.1",
  "private": true,
  "description": "PlayController implementation (specs/engine-api.md PC-001..PC-008): runs the document's KHR_interactivity graph against the interpreter (@gltfi/runtime) or compiled (@gltfi/runtime-lib + @gltfi/ir + @gltfi/emit-ts) engine, fanning outgoing pointer writes out to RenderHost/AudioHost.",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b .",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@gltf-studio/editor-core": "workspace:*",
    "@gltf-studio/engine-api": "workspace:*",
    "@gltfi/emit-ts": "0.0.1",
    "@gltfi/ir": "0.0.1",
    "@gltfi/runtime": "0.0.1",
    "@gltfi/runtime-lib": "0.0.1"
  },
  "devDependencies": {
    "@gltf-studio/contract-tests": "workspace:*",
    "@vitest/browser": "^2.1.8",
    "playwright": "^1.55.0",
    "vitest": "^2.1.8"
  }
}
