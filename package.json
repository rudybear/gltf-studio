{
  "name": "gltf-studio",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @gltf-studio/app run build",
    "test": "vitest run",
    "test:browser": "pnpm --filter @gltf-studio/engine-three run test:browser && pnpm --filter @gltf-studio/audio-webaudio run test:browser && pnpm --filter @gltf-studio/audio-graph run test:browser && pnpm --filter @gltf-studio/play run test:browser",
    "lint": "eslint .",
    "status": "node scripts/gen-status.mjs",
    "check:drift": "node scripts/check-drift.mjs",
    "check:fast": "node scripts/check-drift.mjs --simulate-pr && node scripts/gen-status.mjs --check",
    "check:ci": "node scripts/check-drift.mjs --simulate-pr && node scripts/gen-status.mjs --check && pnpm lint && pnpm drift:selftest && pnpm build && pnpm test",
    "drift:selftest": "node --test scripts/drift.test.mjs",
    "refresh:vendor": "node scripts/refresh-vendor.mjs",
    "dev": "pnpm --filter @gltf-studio/app run dev",
    "e2e": "playwright test",
    "sample": "node scripts/make-sample.mjs",
    "postinstall": "node scripts/setup-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@gltfi/gltf": "0.0.1",
    "@gltfi/runtime": "0.0.1",
    "@gltfi/verify": "0.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
